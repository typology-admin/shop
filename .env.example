# ── Client (Vite inlines VITE_* at build time) ──────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional alias if you still have a legacy JWT anon key:
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Public base URL for objects in the R2 bucket (no trailing slash).
# Use the R2 public development URL or a custom domain:
#   https://pub-xxxxxxxx.r2.dev
# Leave empty to load images through the Pages Function at /api/images/:key
VITE_R2_PUBLIC_BASE_URL=

# Amazon Associates tracking id (appended as ?tag= on amazon.com product URLs)
VITE_AMAZON_ASSOCIATE_TAG=typologynetwo-20

# ── Pages Function (set in Cloudflare dashboard or .dev.vars for wrangler) ──
# Same values as the VITE_ pair; the function uses these names so secrets
# never need a VITE_ prefix.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# ── Optional: Vite-dev R2 upload (when `npm run dev` should write to real R2)
# Create an R2 API token with Object Read & Write on the knoll-items bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=knoll-items
